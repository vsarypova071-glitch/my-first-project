[Unit]
Description=v-sharypova.ru Telegram AI-manager bot
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/v-sharypova.ru/server
ExecStart=/usr/bin/node /var/www/v-sharypova.ru/server/bot.js
EnvironmentFile=/etc/v-sharypova/bot.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/v-sharypova.ru/server/data

[Install]
WantedBy=multi-user.target

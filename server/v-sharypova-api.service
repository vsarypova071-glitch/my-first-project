[Unit]
Description=v-sharypova.ru form-to-Telegram API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/v-sharypova.ru/server
ExecStart=/usr/bin/node /var/www/v-sharypova.ru/server/server.js
EnvironmentFile=/etc/v-sharypova/api.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
